# ─────────────────────────────────────────────────────────────────────────────
# AI Crew Studio — DEV Backend Base Image
# All dependencies pre-installed; source code mounted at runtime.
# ─────────────────────────────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/python-311:latest

USER root

RUN dnf install -y --nodocs \
        git \
        gcc \
        gcc-c++ \
        make \
        jq \
        nodejs \
        npm \
    && dnf clean all \
    && rm -rf /var/cache/dnf

WORKDIR /app

# Install Python dependencies (no source code yet — that's bind-mounted)
COPY agent/pyproject.toml /app/agent/pyproject.toml
RUN cd /app/agent && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e . 2>/dev/null || \
    pip install --no-cache-dir \
        "llama-index>=0.10.0" \
        "llama-index-core>=0.10.0" \
        "llama-index-agent-openai>=0.2.0" \
        "llama-index-llms-openai>=0.1.0" \
        "llama-index-llms-anthropic>=0.1.0" \
        "llama-index-llms-ollama>=0.1.0" \
        "llama-index-embeddings-openai>=0.1.0" \
        "llama-index-embeddings-huggingface>=0.1.0" \
        "gitpython>=3.1.43" \
        "PyYAML>=6.0.2" \
        "rich>=13.9.4" \
        "python-dotenv>=1.0.1" \
        "requests>=2.32.3" \
        "flask>=3.0.0" \
        "flask-cors>=4.0.0" \
        "jsonschema[format]>=4.0.0" \
        "litellm>=1.0.0" \
        "cryptography>=41.0.0"

# Context memory plane (Postgres). Installed explicitly rather than relying on
# the pyproject install above, because that line ends in
# `2>/dev/null || <explicit list>` — when the editable install fails for any
# reason the fallback list is used and every pyproject-only dependency is
# silently dropped. psycopg was declared in pyproject and installed nowhere,
# which is why the whole context-plane code path had never once executed
# against a real database.
#
# Without these the plane is unreachable: blueprints are never persisted and
# recall returns nothing, logged but not fatal, so a deployment looks healthy
# while learning nothing between jobs.
RUN pip install --no-cache-dir \
    "psycopg[binary]>=3.1" \
    "llama-index-vector-stores-postgres>=0.1.14"

# ASGI stack + dev extras
RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.34.0" \
    "httpx>=0.28.0" \
    debugpy watchdog

# Code-intelligence CLI — must match Containerfile.backend, or dev silently
# loses every tldr-backed feature: the wiring symbol diff, code_search, the
# refinement symbol map and prefetched context all no-op when the binary is
# absent, with no error to notice. It was missing here entirely, so dev was
# running blind against a prod image that had it.
#
# Install CLI-only (--no-deps): llm-tldr pulls anthropic>=0.75 which conflicts
# with llama-index-llms-anthropic (<0.29). Only the subprocess CLI is used.
# See Containerfile.backend for why the floor is 1.5.2 and not 1.2.x.
RUN pip install --no-cache-dir "llm-tldr>=1.5.2" --no-deps && \
    pip install --no-cache-dir \
        "pygments-tldr>=2.19.1.3" \
        "pathspec>=0.12.0" \
        "requests>=2.25.0" \
        "rich>=14.2.0" \
        "tree-sitter>=0.23.0" \
        "tree-sitter-python>=0.23.0" \
        "tree-sitter-typescript>=0.23.0" \
        "tree-sitter-javascript>=0.25.0" \
        "tree-sitter-go>=0.25.0" \
        "tree-sitter-rust>=0.24.2" \
        "tree-sitter-java>=0.23.5" \
        "tree-sitter-c>=0.24.2" \
        "tree-sitter-cpp>=0.23.4" \
        "tree-sitter-ruby>=0.23.1" \
        "tree-sitter-php>=0.24.1" \
        "tree-sitter-c-sharp>=0.23.5" \
        "tree-sitter-kotlin>=1.1.0" \
        "tree-sitter-scala>=0.26.0" \
        "tree-sitter-lua<=0.4.1" \
        "tree-sitter-luau" \
        "tree-sitter-elixir>=0.3.0"

RUN mkdir -p /app/workspace /app/data && \
    chown -R 1001:0 /app && \
    chmod -R g=u /app

ENV PYTHONPATH=/app/agent:/app/agent/src:/app \
    PYTHONUNBUFFERED=1 \
    WORKSPACE_PATH=/app/workspace \
    JOB_DB_PATH=/app/data/crew_jobs.db \
    FLASK_ENV=development \
    MOUNT_FLASK_FALLBACK=1 \
    PORT=8080

USER 1001
EXPOSE 8080
